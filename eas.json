{
  "cli": {
    "version": ">= 23.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "pnpm": "9.1.3"
    },
    "preview": {
      "distribution": "internal",
      "pnpm": "9.1.3"
    },
    "production": {
      "autoIncrement": true,
      "pnpm": "9.1.3",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "screenshots": {
      "extends": "production",
      "autoIncrement": false,
      "environment": "production",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6820134837"
      }
    }
  }
}
